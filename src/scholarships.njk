---
layout: base.njk
title: Scholarships
---
<section class="scholarships">
  <h1>Senior scholarships</h1>
  <p class="scholarships__intro">Every year the Hall of Fame awards scholarships to graduating Smithville senior student-athletes who carry on the traditions this hall was built to honor. {{ scholarships.totalRecipients }} scholarships have been awarded since {{ scholarships.firstYear }}.</p>

  {% if site.scholarshipFormUrl %}
  <a href="{{ site.scholarshipFormUrl }}" class="btn btn--green" target="_blank" rel="noopener">Apply for a scholarship</a>
  <p class="form-note">The form opens in a new tab.</p>
  {% else %}
  <p class="form-note">The scholarship application isn't open yet — check back shortly, or reach out to any committee member in the meantime.</p>
  {% endif %}

  <div class="scholarships__list">
    {% for y in scholarships %}
    <div class="scholarship-year">
      <div class="scholarship-year__year">{{ y.year }}</div>
      <ul class="scholarship-year__names">
        {% for name in y.recipients %}
        <li>{{ name }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
